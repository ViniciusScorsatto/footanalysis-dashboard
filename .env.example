FOOTBALL_API_KEY=your_api_sports_key
FOOTBALL_API_HOST=v3.football.api-sports.io

# Public prediction Shorts service
PREDICTION_SERVICE_HOST=0.0.0.0
PREDICTION_SERVICE_PORT=4322
PREDICTION_SERVICE_TOKEN=replace_with_website_service_token
PREDICTION_ADMIN_TOKEN=replace_with_private_admin_token
PREDICTION_DOWNLOAD_SECRET=replace_with_download_signing_secret
PREDICTION_PUBLIC_URL=https://predictions-api.example.com
WEBSITE_REQUEST_TOKEN=replace_with_website_request_token
WEBSITE_DELIVERY_WEBHOOK_URL=https://your-website.example.com/api/predictions/delivery
WEBSITE_DELIVERY_TOKEN=replace_with_delivery_token
FOOTBALL_SEASON=2026

OPENAI_API_KEY=your_openai_api_key
OPENAI_PUBLISHING_MODEL=gpt-4.1-mini

YOUTUBE_PT_CLIENT_ID=your_google_oauth_client_id
YOUTUBE_PT_CLIENT_SECRET=your_google_oauth_client_secret
YOUTUBE_PT_REFRESH_TOKEN=your_pt_channel_refresh_token

YOUTUBE_EN_CLIENT_ID=your_google_oauth_client_id
YOUTUBE_EN_CLIENT_SECRET=your_google_oauth_client_secret
YOUTUBE_EN_REFRESH_TOKEN=your_en_channel_refresh_token

YOUTUBE_PRIVACY_STATUS=private

TIKTOK_PT_CLIENT_KEY= 
TIKTOK_PT_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_PT_REFRESH_TOKEN=your_pt_tiktok_refresh_token

TIKTOK_EN_CLIENT_KEY=your_tiktok_client_key
TIKTOK_EN_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_EN_REFRESH_TOKEN=your_en_tiktok_refresh_token

# TikTok requires registered HTTPS redirect URIs. Set this if your local dashboard is behind a tunnel.
TIKTOK_REDIRECT_URI=https://footanalysis.io/oauth/tiktok/callback
